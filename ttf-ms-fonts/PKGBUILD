pkgname=ttf-ms-fonts
pkgver=1.0.0
pkgrel=1
pkgdesc="Microsoft Windows 11 TrueType fonts (HTTP range installer package)"
arch=('any')
url="https://www.microsoft.com/typography/fonts/"
license=('custom')
depends=('python' 'wimlib' 'fontconfig')
provides=('ttf-font' 'ttf-ms-win11' 'ttf-tahoma' 'emoji-font')
conflicts=('ttf-ms-win11' 'ttf-ms-win11-auto' 'ttf-ms-win11-base' 'ttf-tahoma' 'ttf-vista-fonts')
install="${pkgname}.install"
source=(
  fontdata.sh
  remote_udf.py
  remote_wim_core.py
  remote_wim.py
)
sha256sums=(
  'b1e60444e1efd00428820fa11b5d20a112f6d211369103c5b8d87275b028956f'
  '37fe786f08d00a86381b999f1c80f80d39e2188eed92c33bea89e1ed9e8d26ce'
  '15c2b5cdd0f424704fd7cf056cc86a3a677f23f104f12fa329515c6604ea27b8'
  'bb406509d1500d6a322509be676f5bd7d161e4994d1e3ac0b62ca76f6adb8334'
)

package() {
  install -dm755 "$pkgdir/usr/share/$pkgname"
  install -m644 "$srcdir/fontdata.sh" "$pkgdir/usr/share/$pkgname/"
  install -m644 "$srcdir/remote_udf.py" "$pkgdir/usr/share/$pkgname/"
  install -m644 "$srcdir/remote_wim_core.py" "$pkgdir/usr/share/$pkgname/"
  install -m755 "$srcdir/remote_wim.py" "$pkgdir/usr/share/$pkgname/"

  install -dm755 "$pkgdir/usr/share/licenses/$pkgname"
  cat << 'EOF' > "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
Microsoft Windows Fonts License / EULA Notice:

Microsoft font files remain copyrighted by Microsoft and/or their respective
authors. Usage outside a properly licensed Windows environment may be
restricted by the Microsoft license terms. Review the applicable license and
use requirements before installing or redistributing these fonts.

This package acts as an installer that retrieves Windows 11 fonts
directly from Microsoft's official evaluation ISO using HTTP range requests
during post-installation on the user's system and does not redistribute
proprietary font binaries within the package repository.
EOF

  install -dm755 "$pkgdir/usr/share/doc/$pkgname"
  cat << 'EOF' > "$pkgdir/usr/share/doc/$pkgname/README"
Microsoft Windows 11 Fonts Installer

This package automatically extracts official Microsoft Windows 11
TrueType fonts (Arial, Times New Roman, Calibri, Segoe UI, Tahoma, Consolas,
Cambria, Bahnschrift, etc.) directly from Microsoft's Enterprise Evaluation ISO
using HTTP range requests upon installation.
EOF
}
