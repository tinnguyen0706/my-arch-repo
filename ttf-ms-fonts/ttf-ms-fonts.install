#!/bin/bash

FONT_DIR="/usr/share/fonts/TTF"

post_install() {
    echo ""
    echo "================================================================================"
    echo "  Microsoft Windows 11 Fonts Package Installed"
    echo "================================================================================"
    echo "  To download and extract the official TrueType fonts directly from Microsoft,"
    echo "  please run the following command in your terminal:"
    echo ""
    echo "      sudo ttf-ms-fonts-setup"
    echo ""
    echo "  This downloads only the font chunks (~200 MB) via remote HTTP Range requests"
    echo "  and installs them cleanly into $FONT_DIR."
    echo "================================================================================"
    echo ""
}

post_upgrade() {
    post_install
}

post_remove() {
    echo ":: Note: Installed font files in $FONT_DIR were retained."
    echo ":: If you want to remove them completely, delete Windows font files from $FONT_DIR"
    echo ":: and run 'fc-cache -f'."
}
