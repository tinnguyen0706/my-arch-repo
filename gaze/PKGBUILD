# Maintainer: Gundu Labs <maintainers@gundulabs.com>

pkgname=gaze
pkgver=0.5.3
_ort_ver=1.32.0
pkgrel=1
pkgdesc="Daemon, CLI, and PAM integration for Gaze"
arch=('x86_64')
url="https://gaze.gundulabs.com"
license=('GPL-3.0-or-later')
provides=('gaze' 'gaze-bin')
conflicts=('gaze-bin')
depends=(
  'glibc'
  'gcc-libs'
  'gst-plugin-pipewire'
  'gst-plugins-base'
  'gst-plugins-good'
  'opencv'
  'pam'
  'tpm2-tss'
)
makedepends=(
  'cargo'
  'clang'
  'git'
  'llvm'
  'pkgconf'
  'unzip'
)
backup=(
  'etc/dbus-1/system.d/com.gundulabs.Gaze.conf'
  'etc/gaze/config.toml'
)
install=gaze.install
noextract=(
  "microsoft.ml.onnxruntime.${_ort_ver}.nupkg"
)
source=(
  "https://github.com/GunduLabs/gaze/archive/refs/tags/v${pkgver}/${pkgname}-${pkgver}.tar.gz"
  "microsoft.ml.onnxruntime.${_ort_ver}.nupkg::https://api.nuget.org/v3-flatcontainer/microsoft.ml.onnxruntime/${_ort_ver}/microsoft.ml.onnxruntime.${_ort_ver}.nupkg"
)
sha256sums=(
  '6bec57f478f9a034441d8cf563b085d9ab7c8b7145f280db8c599ada5f05a8fa'
  'a9150bc2992cbbb6722070da9910e1ffa989a8bfc67bdd5bb8e745ca755641db'
)

_srcenv() {
  cd "$srcdir/$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  if check_option lto y; then
    export CARGO_PROFILE_RELEASE_LTO=thin
    export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
  fi
  export CFLAGS+=' -fno-lto'
  export CXXFLAGS+=' -fno-lto'
  export OPENCV_PKGCONFIG_NAME=opencv5
}

prepare() {
  _srcenv
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"

  mkdir -p "$srcdir/ort"
  unzip -qoj "$srcdir/microsoft.ml.onnxruntime.${_ort_ver}.nupkg" \
    LICENSE ThirdPartyNotices.txt "runtimes/linux-x64/native/libonnxruntime.so" \
    -d "$srcdir/ort"
}

build() {
  _srcenv
  # Two invocations match upstream Justfile to keep gaze-vision's detector/inference
  # code out of the client and PAM binaries via Cargo feature isolation.
  cargo build --release --locked \
    --target "$CARCH-unknown-linux-gnu" \
    -p gazed
  cargo build --release --locked \
    --target "$CARCH-unknown-linux-gnu" \
    -p gaze-cli \
    -p pam-gaze \
    -p pam-gaze-grosshack
  scripts/check-pam-link.sh \
    "target/$CARCH-unknown-linux-gnu/release/libpam_gaze.so" \
    "target/$CARCH-unknown-linux-gnu/release/libpam_gaze_grosshack.so"
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  # Daemon and CLI binaries
  install -Dm755 "target/$CARCH-unknown-linux-gnu/release/gazed" "$pkgdir/usr/bin/gazed"
  install -Dm755 "target/$CARCH-unknown-linux-gnu/release/gaze" "$pkgdir/usr/bin/gaze"

  # PAM modules
  install -Dm755 "target/$CARCH-unknown-linux-gnu/release/libpam_gaze.so" "$pkgdir/usr/lib/security/pam_gaze.so"
  install -Dm755 "target/$CARCH-unknown-linux-gnu/release/libpam_gaze_grosshack.so" "$pkgdir/usr/lib/security/pam_gaze_grosshack.so"

  # Systemd unit & configuration
  install -Dm644 "packaging/config/gazed.service" "$pkgdir/usr/lib/systemd/system/gazed.service"
  install -Dm644 "packaging/config/config.toml" "$pkgdir/etc/gaze/config.toml"
  install -Dm644 "packaging/config/com.gundulabs.Gaze.conf" "$pkgdir/etc/dbus-1/system.d/com.gundulabs.Gaze.conf"
  install -Dm644 "packaging/config/com.gundulabs.gaze.policy" "$pkgdir/usr/share/polkit-1/actions/com.gundulabs.gaze.policy"

  # Runtime ONNX dynamic library and notices
  install -Dm644 "$srcdir/ort/libonnxruntime.so" "$pkgdir/usr/lib/gaze/libonnxruntime.so"
  install -Dm644 "$srcdir/ort/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/onnxruntime/LICENSE"
  install -Dm644 "$srcdir/ort/ThirdPartyNotices.txt" "$pkgdir/usr/share/licenses/$pkgname/onnxruntime/ThirdPartyNotices.txt"

  # Gaze project license
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
