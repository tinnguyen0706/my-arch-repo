pkgname=pdfcraft
pkgver=0.14.0
pkgrel=1
pkgdesc="An open-source PDF reader and editor written from scratch in pure Rust"
arch=('x86_64')
url="https://github.com/storytold/pdfcraft"
license=('MIT' 'Apache-2.0')
depends=('glibc' 'libgcc' 'hicolor-icon-theme')
makedepends=('cargo' 'git' 'cmake' 'clang' 'perl')
provides=('pdfcraft' 'printcraft')
conflicts=('pdfcraft-bin' 'pdfcraft-git' 'printcraft' 'printcraft-git')
replaces=('printcraft')
source=("git+https://github.com/storytold/pdfcraft.git#tag=v$pkgver"
        "text-detection.rten::https://ocrs-models.s3-accelerate.amazonaws.com/text-detection.rten"
        "text-recognition.rten::https://ocrs-models.s3-accelerate.amazonaws.com/text-recognition.rten")
sha256sums=('SKIP'
            'f15cfb56bd02c4bf478a20343986504a1f01e1665c2b3a0ad66340f054b1b5ca'
            'e484866d4cce403175bd8d00b128feb08ab42e208de30e42cd9889d8f1735a6e')

build() {
  cd "$pkgname"
  if check_option lto y; then
    export CARGO_PROFILE_RELEASE_LTO=thin
    export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
  fi
  export CFLAGS+=' -fno-lto'
  export CXXFLAGS+=' -fno-lto'
  cargo build --release --locked --target "$CARCH-unknown-linux-gnu" -p "$pkgname"
}

package() {
  cd "$pkgname"
  install -Dm755 "target/$CARCH-unknown-linux-gnu/release/$pkgname" "$pkgdir/usr/bin/$pkgname"

  install -Dm644 "packaging/linux/ai.storyteller.$pkgname.desktop" \
    "$pkgdir/usr/share/applications/ai.storyteller.$pkgname.desktop"

  if [[ -f "packaging/linux/ai.storyteller.$pkgname.mime.xml" ]]; then
    install -Dm644 "packaging/linux/ai.storyteller.$pkgname.mime.xml" \
      "$pkgdir/usr/share/mime/packages/ai.storyteller.$pkgname.xml"
  fi

  for s in 16 24 32 48 64 128 256 512; do
    local icon="assets/app-icon/hicolor/${s}x${s}/apps/ai.storyteller.$pkgname.png"
    if [[ -f "$icon" ]]; then
      install -Dm644 "$icon" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/ai.storyteller.$pkgname.png"
    fi
  done

  local svg="assets/app-icon/hicolor/scalable/apps/ai.storyteller.$pkgname.svg"
  if [[ -f "$svg" ]]; then
    install -Dm644 "$svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/ai.storyteller.$pkgname.svg"
  fi

  for lic in LICENSE-APACHE LICENSE-MIT LICENSE; do
    if [[ -f "$lic" ]]; then
      install -Dm644 "$lic" "$pkgdir/usr/share/licenses/$pkgname/$lic"
    fi
  done

  # Install pre-trained OCR models (Scan & OCR text recognition)
  install -Dm644 "$srcdir/text-detection.rten" "$pkgdir/usr/share/$pkgname/models/text-detection.rten"
  install -Dm644 "$srcdir/text-recognition.rten" "$pkgdir/usr/share/$pkgname/models/text-recognition.rten"
}
