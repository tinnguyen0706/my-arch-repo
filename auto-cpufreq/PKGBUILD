pkgname=auto-cpufreq
pkgver=3.2.0
pkgrel=3
pkgdesc="Automatic CPU speed & power optimizer for Linux"
arch=('any')
url="https://github.com/AdnanHodzic/auto-cpufreq"
license=('GPL-3.0-or-later')
depends=(
  'python'
  'python-setuptools'
  'python-psutil'
  'python-click'
  'python-distro'
  'python-requests'
  'python-gobject'
  'python-pyinotify'
  'python-urwid'
  'python-pyasyncore'
  'dmidecode'
  'gobject-introspection'
  'gtk3'
)
makedepends=(
  'git'
  'python-build'
  'python-installer'
  'python-wheel'
  'python-poetry-core'
  'python-poetry-dynamic-versioning'
)
source=("git+https://github.com/AdnanHodzic/auto-cpufreq.git#tag=v$pkgver"
        "auto-cpufreq.service")
b2sums=('SKIP'
        'SKIP')

prepare() {
  cd "$pkgname"
  sed -i 's|/usr/local|/usr|g' auto_cpufreq/gui/app.py auto_cpufreq/gui/objects.py auto_cpufreq/core.py auto_cpufreq/bin/auto_cpufreq.py scripts/auto-cpufreq-install.sh scripts/auto-cpufreq-remove.sh 2>/dev/null || true
}

build() {
  cd "$pkgname"
  POETRY_DYNAMIC_VERSIONING_BYPASS=1 python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname"
  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 scripts/org.auto-cpufreq.pkexec.policy -t "$pkgdir/usr/share/polkit-1/actions/"
  install -Dm644 images/icon.png "$pkgdir/usr/share/pixmaps/auto-cpufreq.png"
  install -Dm644 images/icon.png -t "$pkgdir/usr/share/$pkgname/"
  install -Dm644 images/icon.png -t "$pkgdir/usr/share/$pkgname/images/"

  mkdir -p "$pkgdir/usr/share/$pkgname/scripts/"
  install -Dm755 scripts/auto-cpufreq-install.sh "$pkgdir/usr/share/$pkgname/scripts/"
  install -Dm755 scripts/auto-cpufreq-remove.sh "$pkgdir/usr/share/$pkgname/scripts/"
  install -Dm644 "$srcdir/auto-cpufreq.service" "$pkgdir/usr/lib/systemd/system/$pkgname.service"
  install -Dm644 "$srcdir/auto-cpufreq.service" "$pkgdir/usr/share/$pkgname/scripts/$pkgname.service"
  install -Dm755 scripts/cpufreqctl.sh "$pkgdir/usr/share/$pkgname/scripts/"
  install -Dm644 scripts/style.css "$pkgdir/usr/share/$pkgname/scripts/"
  install -Dm644 scripts/auto-cpufreq-gtk.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
