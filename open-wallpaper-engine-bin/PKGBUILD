# Maintainer: ZhangHua <admin@waywallen.io>

pkgname=open-wallpaper-engine-bin
pkgver=0.3.1
pkgrel=1
pkgdesc="Open source wallpaper engine implement mostly for linux"
arch=('x86_64')
url="https://github.com/waywallen/open-wallpaper-engine"
license=('GPL-2.0-only')
depends=('waywallen')
provides=('open-wallpaper-engine')
conflicts=('open-wallpaper-engine')
options=(!strip)
source=("org.waywallen.open-wallpaper-engine-${pkgver}-linux-x86_64.zip::https://github.com/waywallen/open-wallpaper-engine/releases/download/v${pkgver}/org.waywallen.open-wallpaper-engine-${pkgver}-linux-x86_64.zip")
sha256sums=('SKIP')

package() {
  local plugin_dir="$pkgdir/usr/share/waywallen/plugins/org.waywallen.open-wallpaper-engine"
  install -dm755 "$plugin_dir"
  cp -r "$srcdir"/plugin.toml "$srcdir"/files.txt "$srcdir"/main.lua "$srcdir"/i18n "$srcdir"/lib "$srcdir"/bin "$srcdir"/wallpaper_engine "$plugin_dir/"

  chmod 755 "$plugin_dir/bin/waywallen-wescene-renderer" \
            "$plugin_dir/lib/weweb/waywallen-weweb-renderer" \
            "$plugin_dir/lib/weweb/chrome-sandbox" 2>/dev/null || true
}
