all_off='\e[1;0m'
bold='\e[1;1m'
blue='\e[1;34m'
green='\e[1;32m'

_configure_autostart() {
    # Only prompt if interactive terminal is attached
    if [ -t 0 ] || [ -e /dev/tty ]; then
        echo ""
        echo -e "${bold}:: Waywallen - Select autostart preference:${all_off}"
        echo -e "   [1] Enable systemd user service (${blue}systemctl --user enable --now waywallen.service${all_off})"
        echo -e "   [2] Create XDG Autostart entry (${blue}~/.config/autostart/org.waywallen.waywallen.desktop${all_off})"
        echo -e "   [3] None / Manual (${green}Do nothing, configure manually in compositor or scripts${all_off})"

        local choice=""
        if [ -e /dev/tty ]; then
            read -r -p "Enter your choice [1/2/3] (default: 3): " choice < /dev/tty 2>/dev/null || choice="3"
        else
            read -r -p "Enter your choice [1/2/3] (default: 3): " choice 2>/dev/null || choice="3"
        fi

        local target_user="${SUDO_USER:-}"
        if [ -z "$target_user" ] || [ "$target_user" = "root" ]; then
            target_user=$(loginctl list-users --no-legend 2>/dev/null | awk '$1 >= 1000 {print $2; exit}')
        fi

        case "$choice" in
            1)
                if [ -n "$target_user" ] && [ "$target_user" != "root" ] && [ -d /run/systemd/system ]; then
                    echo ":: Enabling waywallen.service for user $target_user..."
                    systemctl --user -M "${target_user}@" daemon-reload 2>/dev/null || true
                    systemctl --user -M "${target_user}@" enable --now waywallen.service 2>/dev/null || true
                else
                    echo ":: Please run 'systemctl --user enable --now waywallen.service' as your regular user."
                fi
                ;;
            2)
                if [ -n "$target_user" ] && [ "$target_user" != "root" ]; then
                    local user_home
                    user_home=$(getent passwd "$target_user" | cut -d: -f6)
                    if [ -n "$user_home" ] && [ -d "$user_home" ]; then
                        echo ":: Creating XDG autostart entry for user $target_user..."
                        mkdir -p "$user_home/.config/autostart"
                        cat << 'EOF' > "$user_home/.config/autostart/org.waywallen.waywallen.desktop"
[Desktop Entry]
Type=Application
Name=Waywallen
Exec=waywallen --no-ui
Terminal=false
Categories=Graphics;
X-GNOME-Autostart-enabled=true
EOF
                        chown -R "$target_user:" "$user_home/.config/autostart/org.waywallen.waywallen.desktop"
                    fi
                fi
                ;;
            *)
                echo ":: Autostart not configured (manual mode)."
                ;;
        esac
    fi
}

post_install() {
    _configure_autostart
}

post_upgrade() {
    local target_user="${SUDO_USER:-}"
    if [ -z "$target_user" ] || [ "$target_user" = "root" ]; then
        target_user=$(loginctl list-users --no-legend 2>/dev/null | awk '$1 >= 1000 {print $2; exit}')
    fi
    if [ -n "$target_user" ] && [ "$target_user" != "root" ] && [ -d /run/systemd/system ]; then
        if systemctl --user -M "${target_user}@" is-active waywallen.service >/dev/null 2>&1; then
            echo ":: Restarting waywallen.service for user $target_user..."
            systemctl --user -M "${target_user}@" daemon-reload 2>/dev/null || true
            systemctl --user -M "${target_user}@" restart waywallen.service 2>/dev/null || true
        fi
    fi
}
