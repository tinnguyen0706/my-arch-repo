pkgname=zalo
pkgver=26.10.20
_commithash=6d51fe1
pkgrel=1
pkgdesc="Zalo for Linux — Official Original Version (without ZaDark)"
arch=('x86_64')
url="https://github.com/VN-Linux-Family/zalo-for-linux"
license=('custom')
provides=('zalo-for-linux-bin' 'zalo')
conflicts=('zalo-for-linux-bin' 'zalo-for-linux-git')
depends=(
  'glibc'
  'python'
  'opus'
  'libpulse'
  'alsa-utils'
  'pipewire'
  'rtkit'
  'hicolor-icon-theme'
)
optdepends=(
  'wl-clipboard: paste images from clipboard on Wayland'
  'xclip: paste images from clipboard on X11'
)
options=(!strip !debug)
source=(
  "Zalo-${pkgver}-Original-${_commithash}-x86_64.AppImage::https://github.com/VN-Linux-Family/zalo-for-linux/releases/download/${pkgver}/Zalo-${pkgver}-Original-${_commithash}-x86_64.AppImage"
  "zalo.desktop"
  "Zalo.png"
)
sha256sums=(
  'SKIP'
  'SKIP'
  'SKIP'
)

package() {
  install -Dm755 "${srcdir}/Zalo-${pkgver}-Original-${_commithash}-x86_64.AppImage" "${pkgdir}/usr/bin/zalo"
  install -Dm644 "${srcdir}/zalo.desktop" "${pkgdir}/usr/share/applications/zalo.desktop"
  install -Dm644 "${srcdir}/Zalo.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/zalo.png"
}
