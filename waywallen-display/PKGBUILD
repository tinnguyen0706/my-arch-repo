# Maintainer: ZhangHua <admin@waywallen.io>

pkgname=waywallen-display
pkgver=0.4.3
pkgrel=1
pkgdesc="Desktop integration for waywallen"
arch=(x86_64)
url=https://github.com/waywallen/waywallen-display
license=(MIT)
depends=(libgcc libstdc++ glibc)
makedepends=(cmake vulkan-headers vulkan-icd-loader libglvnd qt6-base qt6-declarative cargo glslang)
optdepends=(
    'libglvnd: EGL backend'
    'vulkan-icd-loader: Vulkan backend'
    'qt6-base: The qml plugin'
    'qt6-declarative: The qml plugin'
)
options=(!lto)
source=("$pkgname-$pkgver.tar.gz::https://github.com/waywallen/waywallen-display/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('a8581e7d0c9b3410a5c9bdc195c0c9850f9c6e6744ac9715b525905112378d10')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target host-tuple
}

build() {
    cmake -B build -S "$pkgname-$pkgver" \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DWAYWALLEN_DISPLAY_PLUGIN_QML=ON
    cmake --build build
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    if check_option lto y; then
        export CARGO_PROFILE_RELEASE_LTO=thin
        export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
    fi
    export CFLAGS+=' -fno-lto'
    export CXXFLAGS+=' -fno-lto'
    RUST_BACKTRACE=full cargo build --frozen --release --all-features \
        --target "$CARCH-unknown-linux-gnu" \
        --package waywallen-display \
        --bin waywallen-layer-shell
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    find "$pkgname-$pkgver/target/$CARCH-unknown-linux-gnu/release" -type f -executable -maxdepth 1 \
        -printf "Installing %p...\n" \
        -exec install -Dm0755 -t "$pkgdir/usr/bin" {} +
    install -Dm0644 "$pkgname-$pkgver/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"
}
