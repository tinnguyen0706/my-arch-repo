all_off='\e[1;0m'
bold='\e[1;1m'
blue='\e[1;34m'
green='\e[1;32m'

_get_target_users() {
    local target_users=()

    if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
        target_users+=("$SUDO_USER")
    fi

    # Lấy thêm user đang đăng nhập phiên đồ họa có UID >= 1000
    while read -r uid user; do
        if [ -n "$user" ] && [ "$user" != "root" ]; then
            case " ${target_users[*]:-} " in
                *" $user "*) ;;
                *) target_users+=("$user") ;;
            esac
        fi
    done < <(loginctl list-users --no-legend 2>/dev/null | awk '$1 >= 1000 {print $1, $2}')

    echo "${target_users[@]}"
}

post_install() {
    echo -e "${blue}--- Cấu hình Bộ gõ Lotus ---${all_off}"
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger 2>/dev/null || true

    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload 2>/dev/null || true
        local users
        users=($(_get_target_users))

        for u in "${users[@]}"; do
            echo -e ":: ${green}Tự động kích hoạt fcitx5-lotus-server cho user ${u}...${all_off}"
            systemctl enable --now "fcitx5-lotus-server@${u}.service" 2>/dev/null || true

            if pgrep -u "$u" -x fcitx5 >/dev/null 2>&1; then
                echo -e ":: ${green}Khởi động lại fcitx5 cho user ${u}...${all_off}"
                systemctl --user -M "${u}@" restart fcitx5.service 2>/dev/null || \
                sudo -u "$u" fcitx5 -r -d 2>/dev/null || \
                pkill -u "$u" -x fcitx5 2>/dev/null || true
            fi
        done
    fi

    echo -e "${bold}Lưu ý cấu hình Fcitx5:${all_off}"
    echo -e "1. Mở 'Fcitx5 Configuration', thêm bộ gõ ${green}Lotus${all_off} nếu chưa thêm."
    echo -e "2. Với Wayland (KDE/Niri): Hãy chọn 'Fcitx 5' trong phần Virtual Keyboard."
    echo "------------------------------------------------"
}

post_upgrade() {
    echo -e "${blue}--- Cập nhật Bộ gõ Lotus ---${all_off}"
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger 2>/dev/null || true

    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload 2>/dev/null || true
        local users
        users=($(_get_target_users))

        for u in "${users[@]}"; do
            echo -e ":: ${green}Khởi động lại fcitx5-lotus-server cho user ${u}...${all_off}"
            systemctl restart "fcitx5-lotus-server@${u}.service" 2>/dev/null || true

            if pgrep -u "$u" -x fcitx5 >/dev/null 2>&1; then
                echo -e ":: ${green}Khởi động lại fcitx5 cho user ${u}...${all_off}"
                systemctl --user -M "${u}@" restart fcitx5.service 2>/dev/null || \
                sudo -u "$u" fcitx5 -r -d 2>/dev/null || \
                pkill -u "$u" -x fcitx5 2>/dev/null || true
            fi
        done
    fi
    echo "------------------------------------------------"
}
