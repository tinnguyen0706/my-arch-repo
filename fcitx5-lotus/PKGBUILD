# Upstream AUR: https://aur.archlinux.org/packages/fcitx5-lotus (aligned with v7.0.2, OpenRC/Runit OFF)
# Maintainer: Nguyen Ky <nhktmdzhg at google mail>

pkgname=fcitx5-lotus
pkgver=7.0.2
pkgrel=1
pkgdesc="Vietnamese input method for fcitx5"
arch=('x86_64')
url="https://github.com/LotusInputMethod/fcitx5-lotus"
license=('GPL-3.0-or-later')
depends=(
  'acl'
  'dbus'
  'fcitx5'
  'fcitx5-configtool'
  'fcitx5-gtk'
  'fcitx5-qt'
  'libevdev'
  'libinput'
  'libnotify'
  'libxcb'
  'hicolor-icon-theme'
  'glibc'
  'libstdc++'
  'libgcc'
  'libudev.so'
  'qt6-base'
  'qt6-declarative'
  'qt6-svg'
  'wayland'
)
makedepends=('cmake' 'extra-cmake-modules' 'gcc' 'git' 'make' 'pkgconf')
install='fcitx5-lotus.install'
source=("git+https://github.com/LotusInputMethod/fcitx5-lotus.git#tag=v$pkgver")
sha256sums=(
  'SKIP'
)

build() {
  cd "$srcdir/fcitx5-lotus"
  # Upstream README & CI (Arch): Qt6 QML settings GUI + pure systemd (OpenRC/Runit OFF)
  cmake \
    -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=/usr/lib \
    -DINSTALL_OPENRC=OFF \
    -DINSTALL_RUNIT=OFF \
    .
  cmake --build build
}

package() {
  cd "$srcdir/fcitx5-lotus"
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
