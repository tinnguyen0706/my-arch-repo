# Maintainer: Nguyen Ky <nhktmdzhg at google mail>

pkgname=fcitx5-lotus
pkgver=6.0.3
pkgrel=1
pkgdesc="Vietnamese input method for fcitx5"
arch=('x86_64')
url="https://github.com/LotusInputMethod/fcitx5-lotus"
license=('GPL-3.0-or-later')
provides=('fcitx5-lotus')
conflicts=('fcitx5-lotus-bin' 'fcitx5-lotus-git')
depends=(
  'acl'
  'fcitx5'
  'fcitx5-configtool'
  'fcitx5-gtk'
  'fcitx5-qt'
  'libevdev'
  'libinput'
  'libnotify'
  'hicolor-icon-theme'
  'glibc'
  'libstdc++'
  'libgcc'
  'libudev.so'
  'python-qtpy'
  'python-dbus'
)
makedepends=('cmake' 'extra-cmake-modules' 'gcc' 'git' 'python')
install='fcitx5-lotus.install'
source=("git+https://github.com/LotusInputMethod/fcitx5-lotus.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
  cd "$srcdir/fcitx5-lotus"
  cmake -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=/usr/lib . \
    -DINSTALL_OPENRC=OFF \
    -DINSTALL_RUNIT=OFF
  make
}

package() {
  cd "$srcdir/fcitx5-lotus"
  make install DESTDIR="$pkgdir"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
